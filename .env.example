# Frontend - Vite (local dev backend; must match backend port 8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# For production build on aipatashala.com: leave VITE_API_BASE_URL empty (unset)
# so the app uses same-origin /api/v1 (proxied to the backend), OR set:
# VITE_API_BASE_URL=https://aipatashala.com/api/v1
# Never build production with a localhost URL - browsers would call the visitor's own machine.

# Backend - FastAPI
APP_ENV=development
DEBUG=true
# For local dev use SQLite, for production use PostgreSQL (Render provides DATABASE_URL)
# Example local: DATABASE_URL=sqlite:///./affiliate.db
# Example production: DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./affiliate.db
SECRET_KEY=replace-with-32+-character-secret
JWT_SECRET_KEY=replace-with-another-32+character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,https://aipatashala.com,https://www.aipatashala.com
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173
# For production: PUBLIC_APP_URL=https://aipatashala.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
AIATOZ_API_KEY=replace-with-secure-production-secret
AIATOZ_REFERRAL_BASE_URL=https://aiatoz.org
# Gmail SMTP — create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_gmail@gmail.com
SMTP_FROM_NAME=AI A to Z
SMTP_USE_TLS=true
RESET_TOKEN_EXPIRE_MINUTES=15
